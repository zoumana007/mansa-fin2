generator client {
  provider = "prisma-client"
  output   = "../../apps/api-gateway/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  CLOSED
}

enum AuthenticationMethodType {
  PASSWORD
}

enum DeviceTrustLevel {
  UNTRUSTED
  TRUSTED
  SUSPENDED
  REVOKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RoleStatus {
  ACTIVE
  ARCHIVED
}

enum AccessScopeType {
  GLOBAL
  SELF
  ORGANIZATION
  COUNTRY
  ENVIRONMENT
  RESOURCE
}

/// Registre technique des versions applicatives du schéma Mansa.
/// Il complète l'historique interne de Prisma sans contenir de donnée métier.
model DatabaseSchemaVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String   @unique @db.VarChar(100)
  checksum    String   @db.VarChar(64)
  description String?  @db.Text
  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("database_schema_versions")
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  email               String                 @unique @db.VarChar(320)
  status              UserStatus             @default(PENDING_VERIFICATION)
  countryCode         String?                @map("country_code") @db.Char(2)
  emailVerifiedAt     DateTime?              @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts Int                    @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?              @map("locked_until") @db.Timestamptz(6)
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  authentication      AuthenticationMethod[]
  devices             UserDevice[]
  sessions            UserSession[]
  roleAssignments     RoleAssignment[]
  accessAuditEntries  AccessAudit[]          @relation("AccessAuditActor")

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  status      RoleStatus       @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String?          @db.Text
  critical    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  roleId      String          @map("role_id") @db.Uuid
  scopeType   AccessScopeType @default(GLOBAL) @map("scope_type")
  scopeId     String?         @map("scope_id") @db.VarChar(100)
  countryCode String?         @map("country_code") @db.Char(2)
  environment String?         @db.VarChar(30)
  reason      String          @db.VarChar(500)
  validFrom   DateTime        @default(now()) @map("valid_from") @db.Timestamptz(6)
  expiresAt   DateTime?       @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([roleId])
  @@map("role_assignments")
}

model AccessAudit {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(150)
  targetType    String   @map("target_type") @db.VarChar(100)
  targetId      String?  @map("target_id") @db.VarChar(100)
  reason        String?  @db.VarChar(500)
  previousValue Json?    @map("previous_value") @db.JsonB
  newValue      Json?    @map("new_value") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor         User?    @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("access_audit")
}

model AuthenticationMethod {
  id         String                   @id @default(uuid()) @db.Uuid
  userId     String                   @map("user_id") @db.Uuid
  type       AuthenticationMethodType
  secretHash String                   @map("secret_hash") @db.Text
  lastUsedAt DateTime?                @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type])
  @@index([userId])
  @@map("authentication_methods")
}

model UserDevice {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  deviceIdentifierHash String           @map("device_identifier_hash") @db.Char(64)
  name                 String?          @db.VarChar(100)
  operatingSystem      String?          @map("operating_system") @db.VarChar(100)
  applicationVersion   String?          @map("application_version") @db.VarChar(50)
  trustLevel           DeviceTrustLevel @default(UNTRUSTED) @map("trust_level")
  approvedAt           DateTime?        @map("approved_at") @db.Timestamptz(6)
  lastSeenAt           DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions             UserSession[]

  @@unique([userId, deviceIdentifierHash])
  @@index([userId, trustLevel])
  @@map("user_devices")
}

model UserSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  deviceId         String        @map("device_id") @db.Uuid
  refreshTokenHash String        @map("refresh_token_hash") @db.Char(64)
  status           SessionStatus @default(ACTIVE)
  ipAddressHash    String?       @map("ip_address_hash") @db.Char(64)
  countryCode      String?       @map("country_code") @db.Char(2)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt   DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  device           UserDevice    @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("user_sessions")
}
