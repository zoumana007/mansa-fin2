model UserDevice {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  deviceIdentifierHash String           @map("device_identifier_hash") @db.Char(64)
  name                 String?          @db.VarChar(100)
  operatingSystem      String?          @map("operating_system") @db.VarChar(100)
  applicationVersion   String?          @map("application_version") @db.VarChar(50)
  trustLevel           DeviceTrustLevel @default(UNTRUSTED) @map("trust_level")
  approvedAt           DateTime?        @map("approved_at") @db.Timestamptz(6)
  lastSeenAt           DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict)
