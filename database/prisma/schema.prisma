generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

/// Registre technique des versions applicatives du schéma Mansa.
/// Il complète l'historique interne de Prisma sans contenir de donnée métier.
model DatabaseSchemaVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String   @unique @db.VarChar(100)
  checksum    String   @db.VarChar(64)
  description String?  @db.Text
  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("database_schema_versions")
}
