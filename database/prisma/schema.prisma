generator client {
  provider = "prisma-client"
  output   = "../../apps/api-gateway/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  CLOSED
}

enum AuthenticationMethodType {
  PASSWORD
}

enum DeviceTrustLevel {
  UNTRUSTED
  TRUSTED
  SUSPENDED
  REVOKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RoleStatus {
  ACTIVE
  ARCHIVED
}

enum AccessScopeType {
  GLOBAL
  SELF
  ORGANIZATION
  COUNTRY
  ENVIRONMENT
  RESOURCE
}

enum LedgerAccountOwnerType {
  USER
  MERCHANT
  MANSA
  PARTNER
  TECHNICAL
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  SUSPENSE
  SETTLEMENT
  FEE
  TAX
  RESERVE
}

enum LedgerNormalBalance {
  DEBIT
  CREDIT
}

enum LedgerAccountStatus {
  ACTIVE
  RESTRICTED
  CLOSED
}

enum LedgerTransactionStatus {
  DRAFT
  PREPARED
  POSTED
  FAILED
  CANCELLED
  REVERSED
  EXPIRED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED
  FAILED
}

enum WalletOwnerType {
  USER
  AGENT
  MERCHANT
  BUSINESS
  INSTITUTION
}

enum WalletType {
  MAIN
  SECONDARY
  PROFESSIONAL
  SAVINGS
  CHILD
  STUDENT
  INVESTMENT
}

enum WalletStatus {
  PENDING
  ACTIVE
  LIMITED
  SUSPENDED
  FROZEN
  CLOSED
}

enum WalletVerificationLevel {
  UNVERIFIED
  BASIC
  VERIFIED
  ENHANCED
}

enum PaymentType {
  INTERNAL
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum KycLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTOMATIC_REVIEW
  MANUAL_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum TransferType {
  MANSA_TO_MANSA
}

enum TransferStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum NotificationCategory {
  SECURITY
  TRANSACTION
  COMPLIANCE
  SERVICE
  REMINDER
  INFORMATION
  PROMOTION
  ADMINISTRATION
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  CREATED
  READ
  EXPIRED
  CANCELLED
}

enum NotificationSensitivity {
  PUBLIC
  PRIVATE
  SENSITIVE
}

enum CashAgentType {
  STANDARD
  PREMIUM
  PARTNER_BRANCH
  MANSA_BRANCH
}

enum CashAgentStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CashAgentFloatStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashDeclarationType {
  OPENING
  INTERIM
  CLOSING
}

/// Registre technique des versions applicatives du schéma Mansa.
/// Il complète l'historique interne de Prisma sans contenir de donnée métier.
model DatabaseSchemaVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String   @unique @db.VarChar(100)
  checksum    String   @db.VarChar(64)
  description String?  @db.Text
  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("database_schema_versions")
}

model User {
  id                   String                     @id @default(uuid()) @db.Uuid
  email                String                     @unique @db.VarChar(320)
  status               UserStatus                 @default(PENDING_VERIFICATION)
  countryCode          String?                    @map("country_code") @db.Char(2)
  emailVerifiedAt      DateTime?                  @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts  Int                        @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?                  @map("locked_until") @db.Timestamptz(6)
  version              Int                        @default(1)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  authentication       AuthenticationMethod[]
  devices              UserDevice[]
  sessions             UserSession[]
  roleAssignments      RoleAssignment[]
  accessAuditEntries   AccessAudit[]              @relation("AccessAuditActor")
  ledgerTransactions   LedgerTransaction[]        @relation("LedgerTransactionCreator")
  ledgerAuditEntries   LedgerAudit[]              @relation("LedgerAuditActor")
  wallets              Wallet[]
  walletAuditEntries   WalletAudit[]              @relation("WalletAuditActor")
  initiatedPayments    Payment[]                  @relation("PaymentInitiator")
  paymentAuditEntries  PaymentAudit[]             @relation("PaymentAuditActor")
  kycProfile           KycProfile?
  kycAuditEntries      KycAudit[]                 @relation("KycAuditActor")
  profile              UserProfile?
  profileAuditEntries  UserProfileAudit[]         @relation("UserProfileAuditActor")
  initiatedTransfers   Transfer[]                 @relation("TransferInitiator")
  receivedTransfers    Transfer[]                 @relation("TransferRecipient")
  transferAuditEntries TransferAudit[]            @relation("TransferAuditActor")
  notifications        Notification[]             @relation("NotificationRecipient")
  notificationAudits   NotificationAudit[]        @relation("NotificationAuditActor")
  cashAgent            CashAgent?                 @relation("CashAgentOwner")
  cashAgentAudits      CashNetworkAudit[]         @relation("CashNetworkAuditActor")
  openedCashRegisters  CashAgentCashRegister[]    @relation("CashRegisterOpenedBy")
  closedCashRegisters  CashAgentCashRegister[]    @relation("CashRegisterClosedBy")
  cashDeclarations     CashAgentCashDeclaration[] @relation("CashDeclarationActor")

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  status      RoleStatus       @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String?          @db.Text
  critical    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  roleId      String          @map("role_id") @db.Uuid
  scopeType   AccessScopeType @default(GLOBAL) @map("scope_type")
  scopeId     String?         @map("scope_id") @db.VarChar(100)
  countryCode String?         @map("country_code") @db.Char(2)
  environment String?         @db.VarChar(30)
  reason      String          @db.VarChar(500)
  validFrom   DateTime        @default(now()) @map("valid_from") @db.Timestamptz(6)
  expiresAt   DateTime?       @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([roleId])
  @@map("role_assignments")
}

model AccessAudit {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(150)
  targetType    String   @map("target_type") @db.VarChar(100)
  targetId      String?  @map("target_id") @db.VarChar(100)
  reason        String?  @db.VarChar(500)
  previousValue Json?    @map("previous_value") @db.JsonB
  newValue      Json?    @map("new_value") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor         User?    @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("access_audit")
}

model LedgerJournal {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique @db.VarChar(50)
  name         String              @db.VarChar(150)
  description  String?             @db.Text
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  transactions LedgerTransaction[]

  @@map("ledger_journals")
}

model LedgerAccount {
  id              String                 @id @default(uuid()) @db.Uuid
  publicReference String                 @unique @map("public_reference") @db.VarChar(50)
  ownerType       LedgerAccountOwnerType @map("owner_type")
  ownerId         String?                @map("owner_id") @db.VarChar(100)
  type            LedgerAccountType
  subtype         String?                @db.VarChar(100)
  currencyCode    String                 @map("currency_code") @db.Char(3)
  countryCode     String                 @map("country_code") @db.Char(2)
  environment     String                 @db.VarChar(30)
  status          LedgerAccountStatus    @default(ACTIVE)
  normalBalance   LedgerNormalBalance    @map("normal_balance")
  restrictions    Json?
  metadata        Json?
  version         Int                    @default(1)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt        DateTime?              @map("closed_at") @db.Timestamptz(6)
  entries         LedgerEntry[]
  wallet          Wallet?
  cashAgentFloat  CashAgentFloatAccount?

  @@index([ownerType, ownerId, status])
  @@index([currencyCode, countryCode, environment, status])
  @@map("ledger_accounts")
}

model CashAgent {
  id              String                  @id @default(uuid()) @db.Uuid
  publicReference String                  @unique @map("public_reference") @db.VarChar(50)
  ownerUserId     String                  @unique @map("owner_user_id") @db.Uuid
  type            CashAgentType           @default(STANDARD)
  status          CashAgentStatus         @default(PENDING_APPROVAL)
  countryCode     String                  @map("country_code") @db.Char(2)
  environment     String                  @db.VarChar(30)
  statusReason    String?                 @map("status_reason") @db.VarChar(500)
  version         Int                     @default(1)
  activatedAt     DateTime?               @map("activated_at") @db.Timestamptz(6)
  suspendedAt     DateTime?               @map("suspended_at") @db.Timestamptz(6)
  closedAt        DateTime?               @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner           User                    @relation("CashAgentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  floatAccounts   CashAgentFloatAccount[]
  auditEntries    CashNetworkAudit[]
  cashRegisters   CashAgentCashRegister[]

  @@index([status, countryCode, environment])
  @@map("cash_agents")
}

model CashAgentFloatAccount {
  id                   String               @id @default(uuid()) @db.Uuid
  cashAgentId          String               @map("cash_agent_id") @db.Uuid
  ledgerAccountId      String               @unique @map("ledger_account_id") @db.Uuid
  currencyCode         String               @map("currency_code") @db.Char(3)
  status               CashAgentFloatStatus @default(ACTIVE)
  minimumAmount        BigInt               @default(0) @map("minimum_amount") @db.BigInt
  maximumAmount        BigInt?              @map("maximum_amount") @db.BigInt
  alertThresholdAmount BigInt               @default(0) @map("alert_threshold_amount") @db.BigInt
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  cashAgent            CashAgent            @relation(fields: [cashAgentId], references: [id], onDelete: Restrict)
  ledgerAccount        LedgerAccount        @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([cashAgentId, currencyCode])
  @@index([cashAgentId, status])
  @@map("cash_agent_float_accounts")
}

model CashNetworkAudit {
  id            String    @id @default(uuid()) @db.Uuid
  cashAgentId   String    @map("cash_agent_id") @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  action        String    @db.VarChar(150)
  reason        String?   @db.VarChar(500)
  previousValue Json?     @map("previous_value") @db.JsonB
  newValue      Json?     @map("new_value") @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  cashAgent     CashAgent @relation(fields: [cashAgentId], references: [id], onDelete: Restrict)
  actor         User?     @relation("CashNetworkAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([cashAgentId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("cash_network_audit")
}

model CashAgentCashRegister {
  id                    String                     @id @default(uuid()) @db.Uuid
  publicReference       String                     @unique @map("public_reference") @db.VarChar(50)
  cashAgentId           String                     @map("cash_agent_id") @db.Uuid
  currencyCode          String                     @map("currency_code") @db.Char(3)
  status                CashRegisterStatus         @default(OPEN)
  openingAmount         BigInt                     @map("opening_amount") @db.BigInt
  theoreticalAmount     BigInt                     @map("theoretical_amount") @db.BigInt
  declaredClosingAmount BigInt?                    @map("declared_closing_amount") @db.BigInt
  varianceAmount        BigInt?                    @map("variance_amount") @db.BigInt
  openingDenominations  Json?                      @map("opening_denominations") @db.JsonB
  closingDenominations  Json?                      @map("closing_denominations") @db.JsonB
  openedByUserId        String                     @map("opened_by_user_id") @db.Uuid
  closedByUserId        String?                    @map("closed_by_user_id") @db.Uuid
  closingReason         String?                    @map("closing_reason") @db.VarChar(500)
  version               Int                        @default(1)
  openedAt              DateTime                   @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt              DateTime?                  @map("closed_at") @db.Timestamptz(6)
  cashAgent             CashAgent                  @relation(fields: [cashAgentId], references: [id], onDelete: Restrict)
  openedBy              User                       @relation("CashRegisterOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy              User?                      @relation("CashRegisterClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  declarations          CashAgentCashDeclaration[]

  @@index([cashAgentId, status, openedAt])
  @@map("cash_agent_cash_registers")
}

model CashAgentCashDeclaration {
  id               String                @id @default(uuid()) @db.Uuid
  cashRegisterId   String                @map("cash_register_id") @db.Uuid
  declaredByUserId String                @map("declared_by_user_id") @db.Uuid
  type             CashDeclarationType
  amount           BigInt                @db.BigInt
  denominations    Json?                 @db.JsonB
  note             String?               @db.VarChar(500)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  cashRegister     CashAgentCashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  declaredBy       User                  @relation("CashDeclarationActor", fields: [declaredByUserId], references: [id], onDelete: Restrict)

  @@index([cashRegisterId, createdAt])
  @@index([declaredByUserId, createdAt])
  @@map("cash_agent_cash_declarations")
}

model LedgerTransaction {
  id                String                  @id @default(uuid()) @db.Uuid
  journalId         String                  @map("journal_id") @db.Uuid
  type              String                  @db.VarChar(100)
  businessReference String?                 @map("business_reference") @db.VarChar(100)
  idempotencyKey    String                  @map("idempotency_key") @db.VarChar(150)
  requestHash       String                  @map("request_hash") @db.Char(64)
  status            LedgerTransactionStatus @default(DRAFT)
  currencyCode      String                  @map("currency_code") @db.Char(3)
  countryCode       String                  @map("country_code") @db.Char(2)
  environment       String                  @db.VarChar(30)
  description       String                  @db.VarChar(500)
  correlationId     String?                 @map("correlation_id") @db.VarChar(100)
  source            String                  @db.VarChar(100)
  createdByUserId   String                  @map("created_by_user_id") @db.Uuid
  effectiveAt       DateTime                @map("effective_at") @db.Timestamptz(6)
  postedAt          DateTime?               @map("posted_at") @db.Timestamptz(6)
  parentId          String?                 @map("parent_id") @db.Uuid
  metadata          Json?
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  journal           LedgerJournal           @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("LedgerTransactionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  parent            LedgerTransaction?      @relation("LedgerTransactionParent", fields: [parentId], references: [id], onDelete: Restrict)
  children          LedgerTransaction[]     @relation("LedgerTransactionParent")
  entries           LedgerEntry[]
  auditEntries      LedgerAudit[]
  payment           Payment?

  @@unique([environment, idempotencyKey])
  @@index([businessReference])
  @@index([correlationId])
  @@index([status, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  accountId     String               @map("account_id") @db.Uuid
  direction     LedgerEntryDirection
  amount        BigInt               @db.BigInt
  currencyCode  String               @map("currency_code") @db.Char(3)
  sequence      Int
  status        LedgerEntryStatus    @default(PENDING)
  label         String               @db.VarChar(300)
  reference     String?              @db.VarChar(100)
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, sequence])
  @@index([accountId, status, createdAt])
  @@map("ledger_entries")
}

model LedgerAudit {
  id            String             @id @default(uuid()) @db.Uuid
  transactionId String?            @map("transaction_id") @db.Uuid
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  action        String             @db.VarChar(150)
  reason        String?            @db.VarChar(500)
  details       Json?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   LedgerTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  actor         User?              @relation("LedgerAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("ledger_audit")
}

model Wallet {
  id                String                  @id @default(uuid()) @db.Uuid
  publicReference   String                  @unique @map("public_reference") @db.VarChar(50)
  ownerType         WalletOwnerType         @map("owner_type")
  ownerId           String                  @map("owner_id") @db.VarChar(100)
  ownerUserId       String?                 @map("owner_user_id") @db.Uuid
  type              WalletType
  currencyCode      String                  @map("currency_code") @db.Char(3)
  countryCode       String                  @map("country_code") @db.Char(2)
  environment       String                  @db.VarChar(30)
  status            WalletStatus            @default(PENDING)
  verificationLevel WalletVerificationLevel @default(UNVERIFIED) @map("verification_level")
  ledgerAccountId   String                  @unique @map("ledger_account_id") @db.Uuid
  limits            Json?
  statusReason      String?                 @map("status_reason") @db.VarChar(500)
  frozenAt          DateTime?               @map("frozen_at") @db.Timestamptz(6)
  closedAt          DateTime?               @map("closed_at") @db.Timestamptz(6)
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerUser         User?                   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  ledgerAccount     LedgerAccount           @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  auditEntries      WalletAudit[]
  outgoingPayments  Payment[]               @relation("PaymentPayerWallet")
  incomingPayments  Payment[]               @relation("PaymentPayeeWallet")
  sentTransfers     Transfer[]

  @@unique([ownerType, ownerId, type, currencyCode, environment])
  @@index([ownerUserId, status])
  @@index([countryCode, currencyCode, environment, status])
  @@map("wallets")
}

model WalletAudit {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(150)
  reason        String?  @db.VarChar(500)
  previousValue Json?    @map("previous_value") @db.JsonB
  newValue      Json?    @map("new_value") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  actor         User?    @relation("WalletAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("wallet_audit")
}

model Payment {
  id                  String             @id @default(uuid()) @db.Uuid
  publicReference     String             @unique @map("public_reference") @db.VarChar(50)
  type                PaymentType        @default(INTERNAL)
  status              PaymentStatus      @default(INITIATED)
  payerWalletId       String             @map("payer_wallet_id") @db.Uuid
  payeeWalletId       String             @map("payee_wallet_id") @db.Uuid
  amount              BigInt             @db.BigInt
  feeAmount           BigInt             @default(0) @map("fee_amount") @db.BigInt
  currencyCode        String             @map("currency_code") @db.Char(3)
  countryCode         String             @map("country_code") @db.Char(2)
  environment         String             @db.VarChar(30)
  idempotencyKey      String             @map("idempotency_key") @db.VarChar(150)
  requestHash         String             @map("request_hash") @db.Char(64)
  description         String             @db.VarChar(500)
  initiatedByUserId   String             @map("initiated_by_user_id") @db.Uuid
  ledgerTransactionId String?            @unique @map("ledger_transaction_id") @db.Uuid
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(6)
  failureCode         String?            @map("failure_code") @db.VarChar(100)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  payerWallet         Wallet             @relation("PaymentPayerWallet", fields: [payerWalletId], references: [id], onDelete: Restrict)
  payeeWallet         Wallet             @relation("PaymentPayeeWallet", fields: [payeeWalletId], references: [id], onDelete: Restrict)
  initiatedBy         User               @relation("PaymentInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  ledgerTransaction   LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  auditEntries        PaymentAudit[]
  transfer            Transfer?

  @@unique([environment, idempotencyKey])
  @@index([payerWalletId, createdAt])
  @@index([payeeWalletId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

